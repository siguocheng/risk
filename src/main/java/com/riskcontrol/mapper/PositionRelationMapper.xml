<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.riskcontrol.dao.PositionRelationMapper">

    <resultMap id="BaseResultMap" type="com.riskcontrol.domain.PositionRelation">
        <id column="id" jdbcType="BIGINT" property="id"/>
        <result column="account_code" jdbcType="VARCHAR" property="accountCode"/>
        <result column="conid" jdbcType="INTEGER" property="conid"/>
        <result column="strategy_name" jdbcType="VARCHAR" property="strategyName"/>
        <result column="trader_name" jdbcType="VARCHAR" property="traderName"/>
        <result column="position_qty" jdbcType="DECIMAL" property="positionQty"/>
        <result column="deleted" jdbcType="TINYINT" property="deleted"/>
        <result column="create_id" jdbcType="BIGINT" property="createId"/>
        <result column="create_time" jdbcType="TIMESTAMP" property="createTime"/>
        <result column="modified_id" jdbcType="BIGINT" property="modifiedId"/>
        <result column="modified_time" jdbcType="TIMESTAMP" property="modifiedTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, account_code, conid, strategy_name, trader_name, position_qty, deleted, create_id, create_time, modified_id, modified_time
    </sql>

    <select id="listPortfolioOverviewDetail" resultType="com.riskcontrol.domain.vo.PortfolioOverviewDetail">
        SELECT
            t.trader_name,
            t.capital,
            c.delta,
            c.multiplier,
            c.sec_type,
            pr.position_qty,
            pr.avg_cost,
            pr.market_price,
            pr.unrealized_pnl,
            pr.realized_pnl,
            pr.commission_and_fees
        FROM
            trader t
        LEFT JOIN position_relation pr ON t.trader_name = pr.trader_name
        LEFT JOIN contract c ON pr.conid = c.conid
        where 1=1
        <if test="accountCodes != null and accountCodes.size() > 0">
            and pr.account_code IN
            <foreach collection="accountCodes" item="code" open="(" separator="," close=")">
                #{code}
            </foreach>
        </if>
        <if test="tradeNames != null and tradeNames.size() > 0">
            and pr.trader_name IN
            <foreach collection="tradeNames" item="name" open="(" separator="," close=")">
                #{name}
            </foreach>
        </if>
        <if test="strategyNames != null and strategyNames.size() > 0">
            and pr.strategy_name IN
            <foreach collection="strategyNames" item="name" open="(" separator="," close=")">
                #{name}
            </foreach>
        </if>
    </select>

</mapper>
