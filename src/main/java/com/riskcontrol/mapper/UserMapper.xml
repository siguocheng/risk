<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.riskcontrol.dao.UserMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.riskcontrol.domain.User">
        <result column="id" property="id" />
        <result column="deleted" property="deleted" />
        <result column="create_id" property="createId" />
        <result column="create_time" property="createTime" />
        <result column="modified_id" property="modifiedId" />
        <result column="modified_time" property="modifiedTime" />
        <result column="account_name" property="accountName" />
        <result column="name" property="name" />
        <result column="email" property="email" />
        <result column="password" property="password" />
        <result column="mobile" property="mobile" />
    </resultMap>

    <select id="queryPage" resultType="com.riskcontrol.domain.vo.user.UserPage">
        select
            u.id,
            u.account_name,
            u.name,
            u.email,
            u.password,
            u.mobile,
            u.create_id,
            u.create_time,
            u.modified_id,
            u.modified_time,
            r.id role_id,
            r.name roleName
        from user u
        LEFT JOIN user_role ur on u.id = ur.user_id AND ur.deleted = 0
        LEFT JOIN role r ON ur.role_id = r.id
        where u.deleted = 0
        order by u.id desc
    </select>
    <update id="updatePassword">
        UPDATE user set password = #{password} where id = #{id}
    </update>
</mapper>
