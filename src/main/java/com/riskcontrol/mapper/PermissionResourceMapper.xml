<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.riskcontrol.dao.PermissionResourceMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.riskcontrol.domain.PermissionResource">
        <result column="id" property="id" />
        <result column="deleted" property="deleted" />
        <result column="create_id" property="createId" />
        <result column="create_time" property="createTime" />
        <result column="modified_id" property="modifiedId" />
        <result column="modified_time" property="modifiedTime" />
        <result column="permission_code" property="permissionCode" />
        <result column="resource_url" property="resourceUrl" />
    </resultMap>

    <delete id="deleteAll">
        delete from permission_resource
    </delete>

    <select id="getPermissionResourceByUserId" resultType="java.lang.String">
        select distinct res.resource_url
        from permission_resource as res
                 inner join permission p on res.permission_code = p.permission_code
            and res.deleted=p.deleted
                 inner join permission_role as p_role on p.id = p_role.permission_id
                 inner join role on p_role.role_id = role.id
                 inner join user_role as u_role on role.id = u_role.role_id
        where u_role.user_id = #{userId}
        group by res.id
    </select>
</mapper>
